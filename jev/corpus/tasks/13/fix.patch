+
+
+def archive_old_orders(orders: list[Order], days: int = 90, today: date | None = None) -> tuple[list[Order], list[Order]]:
+    if today is None:
+        today = clock.today()
+
+    recent = []
+    archived = []
+
+    for order in orders:
+        if (today - order.date).days <= days:
+            recent.append(order)
+        else:
+            archived.append(order)
+
+    return recent, archived
