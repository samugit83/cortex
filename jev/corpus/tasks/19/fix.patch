diff --git a/shop/plugins/ndjson_export.py b/shop/plugins/ndjson_export.py
new file mode 100644
index 0000000..58139d6
--- /dev/null
+++ b/shop/plugins/ndjson_export.py
@@ -0,0 +1,27 @@
+"""NDJSON: one JSON object per order line."""
+import json
+
+from .base import Exporter
+
+
+class NdjsonExporter(Exporter):
+    name = "ndjson"
+    extension = "ndjson"
+
+    def export(self, orders) -> str:
+        lines = []
+        for o in orders:
+            for line in o.lines:
+                obj = {
+                    "order": o.id,
+                    "date": o.date.isoformat(),
+                    "customer": o.customer,
+                    "status": o.status,
+                    "sku": line.sku,
+                    "name": line.name,
+                    "qty": line.qty,
+                    "unit_price": str(line.unit_price),
+                    "total": str(line.total),
+                }
+                lines.append(json.dumps(obj, ensure_ascii=False))
+        return "\n".join(lines) + "\n" if lines else ""
