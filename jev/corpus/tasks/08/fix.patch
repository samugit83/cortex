diff --git a/shop/plugins/tsv_export.py b/shop/plugins/tsv_export.py
new file mode 100644
index 0000000..ceba534
--- /dev/null
+++ b/shop/plugins/tsv_export.py
@@ -0,0 +1,20 @@
+"""TSV: one row per order line, tab-separated."""
+import csv
+import io
+
+from .base import Exporter
+
+
+class TsvExporter(Exporter):
+    name = "tsv"
+    extension = "tsv"
+
+    def export(self, orders) -> str:
+        buf = io.StringIO()
+        w = csv.writer(buf, delimiter="\t", lineterminator="\n")
+        w.writerow(["order", "date", "customer", "sku", "qty", "unit_price", "line_total"])
+        for o in orders:
+            for line in o.lines:
+                w.writerow([o.id, o.date.isoformat(), o.customer, line.sku, line.qty,
+                            str(line.unit_price), str(line.total)])
+        return buf.getvalue()
