+
+
+def new_arrivals(products: list[Product], days: int = 30, today: date | None = None) -> list[Product]:
+    """Products added in the last `days` days."""
+    if today is None:
+        today = clock.today()
+    cutoff = today - timedelta(days=days)
+    return [p for p in products if p.added > cutoff]
