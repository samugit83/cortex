diff --git a/shop/plugins/html_export.py b/shop/plugins/html_export.py
new file mode 100644
index 0000000..07e4f9b
--- /dev/null
+++ b/shop/plugins/html_export.py
@@ -0,0 +1,33 @@
+"""HTML: a table with one row per order line."""
+from .base import Exporter
+
+
+class HtmlExporter(Exporter):
+    name = "html"
+    extension = "html"
+
+    def export(self, orders) -> str:
+        headers = ["order", "date", "customer", "sku", "qty", "unit_price", "line_total"]
+        lines = ["<table>"]
+
+        # Header row
+        lines.append("<tr>")
+        for header in headers:
+            lines.append(f"<th>{header}</th>")
+        lines.append("</tr>")
+
+        # Data rows
+        for o in orders:
+            for line in o.lines:
+                lines.append("<tr>")
+                lines.append(f"<td>{o.id}</td>")
+                lines.append(f"<td>{o.date.isoformat()}</td>")
+                lines.append(f"<td>{o.customer}</td>")
+                lines.append(f"<td>{line.sku}</td>")
+                lines.append(f"<td>{line.qty}</td>")
+                lines.append(f"<td>{line.unit_price}</td>")
+                lines.append(f"<td>{line.total}</td>")
+                lines.append("</tr>")
+
+        lines.append("</table>")
+        return "\n".join(lines) + "\n"
