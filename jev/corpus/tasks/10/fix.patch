diff --git a/shop/plugins/markdown_export.py b/shop/plugins/markdown_export.py
new file mode 100644
index 0000000..76ec4bd
--- /dev/null
+++ b/shop/plugins/markdown_export.py
@@ -0,0 +1,20 @@
+"""Markdown: a table with one row per order line."""
+from .base import Exporter
+
+
+class MarkdownExporter(Exporter):
+    name = "markdown"
+    extension = "md"
+
+    def export(self, orders) -> str:
+        headers = ["order", "date", "customer", "sku", "qty", "unit_price", "line_total"]
+        lines = ["| " + " | ".join(headers) + " |"]
+        lines.append("|" + "|".join(["-:" if i > 0 else "-" for i in range(len(headers))]) + "|")
+
+        for o in orders:
+            for line in o.lines:
+                row = [o.id, o.date.isoformat(), o.customer, line.sku, str(line.qty),
+                       str(line.unit_price), str(line.total)]
+                lines.append("| " + " | ".join(row) + " |")
+
+        return "\n".join(lines) + "\n"
