diff --git a/shop/plugins/xml_export.py b/shop/plugins/xml_export.py
new file mode 100644
index 0000000..811fa45
--- /dev/null
+++ b/shop/plugins/xml_export.py
@@ -0,0 +1,21 @@
+"""XML: the orders as an XML document with order and line elements."""
+import xml.etree.ElementTree as ET
+
+from .base import Exporter
+
+
+class XmlExporter(Exporter):
+    name = "xml"
+    extension = "xml"
+
+    def export(self, orders) -> str:
+        root = ET.Element("orders")
+        for o in orders:
+            order_elem = ET.SubElement(root, "order")
+            order_elem.set("id", o.id)
+            order_elem.set("total", str(o.total))
+            for l in o.lines:
+                line_elem = ET.SubElement(order_elem, "line")
+                line_elem.set("sku", l.sku)
+                line_elem.set("qty", str(l.qty))
+        return ET.tostring(root, encoding="unicode") + "\n"
