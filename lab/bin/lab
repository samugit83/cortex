#!/usr/bin/env python3
"""lab — drive the Cortex end-to-end lab from a terminal.

  lab status                 where we are: round, next session, what is done
  lab next                   start the next session: a teammate's commit lands
                             in cortex-lab, and the prompt to paste is printed
  lab verify                 act as CI + the user: is the fix complete and does it
                             follow the house rules? prints the reply to paste
  lab done                   after /harvest: record the outcome and commit
  lab done --late [ID]       attach a /harvest run AFTER `lab done` to that session
  lab prompt [ID]            print a session's prompt again
  lab commit                 after /evolve: commit what it changed (skills, journal)

  (for the experimenter)
  lab build [--force]        create cortex-lab from lab/seed with a realistic history
  lab validate [ID ...]      prove each scenario: the test fails when injected, the
                             reference fix passes the oracle, a rule-breaking fix does not
  lab audit [ID ...]         does each harvested task's check.sh tell a house-rule fix
                             from a rule-breaking one?

The lab repository defaults to ../../cortex-lab next to the Cortex folder
(override with LAB_REPO; LAB_STATE moves the state file, for rehearsals).
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

sys.dont_write_bytecode = True               # keep lab/bin free of __pycache__
HERE = Path(__file__).resolve().parent
LAB_HOME = HERE.parent                       # Cortex/lab
sys.path.insert(0, str(HERE))
import scenarios as S                        # noqa: E402

REPO = Path(os.environ.get("LAB_REPO", LAB_HOME.parent.parent / "cortex-lab"))
STATE = Path(os.environ.get("LAB_STATE", LAB_HOME / "state" / "state.json"))
SEED = LAB_HOME / "seed"
ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")


# ------------------------------------------------------------------ helpers --
def die(msg, code=1):
    print(f"lab: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, cwd, check=False, env=None, capture=True):
    r = subprocess.run(cmd, cwd=cwd, capture_output=capture, text=True, env=env or ENV)
    if check and r.returncode != 0:
        die(f"{' '.join(cmd)} failed:\n{r.stdout}{r.stderr}")
    return r


def git(repo, *args, check=True, env=None):
    return run(["git", *args], repo, check=check, env=env).stdout.strip()


def load_state():
    if STATE.exists():
        return json.loads(STATE.read_text())
    return {"current": None, "scenarios": {}}


def save_state(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2, sort_keys=True) + "\n")
    tmp.replace(STATE)


def now():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def round_of(sid):
    for r, ids in S.ROUNDS.items():
        if sid in ids:
            return r
    return None


def author_env(author, when=None):
    name, email = re.match(r"(.*) <(.*)>", author).groups()
    env = dict(ENV, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
               GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email)
    if when:
        env.update(GIT_AUTHOR_DATE=when, GIT_COMMITTER_DATE=when)
    return env


def purge_caches(repo):
    for d in Path(repo).rglob("__pycache__"):
        shutil.rmtree(d, ignore_errors=True)


# --------------------------------------------------------------- edit ops ---
def _replace_once(path, old, new):
    text = path.read_text(encoding="utf-8")
    n = text.count(old)
    if n != 1:
        raise RuntimeError(f"{path.name}: expected the anchor exactly once, found {n}: {old[:60]!r}")
    path.write_text(text.replace(old, new), encoding="utf-8")


def _changelog(path, section, bullet):
    lines = path.read_text(encoding="utf-8").splitlines()
    start = lines.index("## [Unreleased]")
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## [")), len(lines))
    head = next((i for i in range(start + 1, end) if lines[i].strip() == f"### {section}"), None)
    if head is None:
        block = [f"### {section}", f"- {bullet}", ""]
        at = end
        while at > start + 1 and lines[at - 1].strip() == "":
            at -= 1
        lines[at:at] = ([""] if lines[at - 1].strip() else []) + block
    else:
        at = head + 1
        while at < end and lines[at].startswith("- "):
            at += 1
        lines.insert(at, f"- {bullet}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def _register(path, name, module, cls):
    text = path.read_text(encoding="utf-8")
    imports = [m.end() for m in re.finditer(r"^from \.\w+ import \w+\n", text, re.M)]
    text = text[:imports[-1]] + f"from .{module} import {cls}\n" + text[imports[-1]:]
    close = text.index("}", text.index("EXPORTERS = {"))
    text = text[:close] + f'    "{name}": {cls},\n' + text[close:]
    path.write_text(text, encoding="utf-8")


def _docs_row(path, name, ext, desc):
    lines = path.read_text(encoding="utf-8").splitlines()
    last = max(i for i, l in enumerate(lines) if l.startswith("|"))
    lines.insert(last + 1, f"| {name} | {ext} | {desc} |")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def apply_edits(repo, edits):
    repo = Path(repo)
    for op in edits:
        kind = op[0]
        if kind == "replace":
            _replace_once(repo / op[1], op[2], op[3])
        elif kind == "write":
            (repo / op[1]).parent.mkdir(parents=True, exist_ok=True)
            (repo / op[1]).write_text(op[2], encoding="utf-8")
        elif kind == "write_append":
            with open(repo / op[1], "a", encoding="utf-8") as fh:
                fh.write(op[2])
        elif kind == "changelog":
            _changelog(repo / "CHANGELOG.md", op[1], op[2])
        elif kind == "register":
            _register(repo / "shop/plugins/registry.py", op[1], op[2], op[3])
        elif kind == "docs_row":
            _docs_row(repo / "docs/exporters.md", op[1], op[2], op[3])
        elif kind == "golden":
            run(["python3", "tools/golden.py"], repo, check=True)
        else:
            raise RuntimeError(f"unknown edit {kind}")


def naive_edits(s):
    """A plausible fix that breaks the family's house rule (None for the control family)."""
    if s["naive"] is not None:
        return s["naive"]
    if s["family"] == "A":
        return [e for e in s["solve"] if e[0] != "changelog"]
    if s["family"] == "C":
        return [e for e in s["solve"] if e[0] not in ("docs_row", "golden")]
    return None


# ------------------------------------------------------------------ oracle ---
LINT_KIND = {"money": "B", "time": "E", "exporters": "C"}


def oracle(repo, s, base):
    """What CI and a careful reviewer see. Returns (verdict, detail): verdict is
    'ok', 'test', 'suite', 'A' (no changelog) or a lint family 'B' / 'C' / 'E'."""
    purge_caches(repo)
    for rel, content in s["files"].items():          # QA's test is the spec: never weakened
        p = Path(repo) / rel
        if not p.exists() or p.read_text(encoding="utf-8") != content:
            return "tampered", [f"{rel} differs from what QA committed"]
    r = run(["python3", "-m", "unittest", s["test"]], repo)
    if r.returncode != 0:
        return "test", (r.stdout + r.stderr).strip().splitlines()[-1:]
    r = run(["python3", "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-q"], repo)
    if r.returncode != 0:
        tail = [l for l in (r.stdout + r.stderr).splitlines() if l.startswith(("FAIL:", "ERROR:"))]
        return "suite", tail[:5] or ["make test fails"]
    r = run(["python3", "tools/lint.py"], repo)
    if r.returncode != 0:
        problems = [l for l in r.stdout.splitlines() if ": " in l and not l.startswith("lint:")]
        kind = "B"
        for l in problems:
            m = re.search(r": (money|time|exporters): ", l)
            if m:
                kind = LINT_KIND[m.group(1)]
                break
        return kind, problems[:5]
    if s["family"] == "A":
        diff = git(repo, "diff", base, "--", "CHANGELOG.md", check=False)
        if not any(l.startswith("+- ") for l in diff.splitlines()):
            return "A", ["CHANGELOG.md has no new line under [Unreleased]"]
    return "ok", []


def correction(verdict, s):
    return S.CORRECTIONS[verdict].format(test=s["test"], file=", ".join(s["files"]))


# ------------------------------------------------------------------- build ---
