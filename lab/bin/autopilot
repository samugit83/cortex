#!/usr/bin/env python3
"""autopilot — run lab rounds with no one at the keyboard.

  autopilot round N          round N: every session (prompt, verify, corrections,
                             /harvest, done), then /evolve until the cycle ends, then commit
  autopilot evolve N         only the /evolve part of round N
  autopilot prune             the /prune pass: plan, approve, measure, record
  autopilot ask ID "message"  say something in session ID's own chat (no bookkeeping)
  autopilot reharvest ID "note"
                             after a Cortex fix: /harvest again in session ID's own
                             chat, with the note a user would add, then `lab done --late`

  --jev off | on             whether Cortex may consult Jev during this run.
                             DEFAULT: off, for every run that produces a primary
                             number. See "Jev" below.
  --no-evolve                the CONTROL run: every session, every correction and
                             every /harvest exactly as usual, and no /evolve at
                             all. Corrections still fall if the agent is learning
                             from the code it has already written, so this is what
                             an evaluation run's fall has to beat (H4).
  --max-turns N              cap one Claude call at N assistant turns (default 40).
                             A call that hits it is recorded with hit_turn_cap.
  --turn-timeout MIN         abandon one Claude call after MIN minutes (default 15).

Every Claude turn is a real headless Claude Code session in cortex-lab (Haiku 4.5),
fed exactly what the user would type: the scenario's prompt, the correction
`lab verify` prints, `/harvest`, `/evolve`. Permissions are the user's own mode
(bypassPermissions), minus a deny list. The scheduler tool is disabled: the
autopilot does the waiting and re-runs /evolve itself, as a user would.

Nothing is repaired by hand. When a step does not do what the protocol says, the
autopilot logs a FINDING and moves on (or stops, if going on would corrupt data).
Log: lab/state/autopilot.log   turns: lab/state/autopilot.json

Jev
---
Cortex can consult Jev (a calibrated judge) in its PROPOSAL layer: which theme
recurs, which tier fits, how much of the suite a candidate is actually about. It
never touches the gates. But it does change WHICH candidate gets proposed, so for
this lab it is a treatment, not tooling:

  * `--jev off` (the default) is what every run producing a primary number uses.
    The development run D0 had no Jev at all, so a Jev-on run is not comparable
    with it and cannot test "D0 replicates".
  * `--jev on` requires JEV_MODEL pinned to an EXACT version. `jev-latest` is an
    alias on someone else's server: freezing Cortex's git tag does not freeze it,
    and a run whose judge moved underneath it is not reproducible. The autopilot
    refuses to start in that case rather than produce data nobody can trust.

Either way the choice, the model id and the endpoint are recorded in
lab/state/autopilot.json under `manifest`, so a reader can tell which runs saw a
judge without taking anyone's word for it.
"""
import json
import os
import shutil
import subprocess
import sys
import time
import types
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import guard                                     # noqa: E402
src = (HERE / "lab").read_text()
L = types.ModuleType("labtool")
L.__file__ = str(HERE / "lab")
exec(compile(src, "lab", "exec"), L.__dict__)
S = L.S
REPO = L.REPO
STATE_DIR = L.STATE.parent
LOG = STATE_DIR / "autopilot.log"
TURNS = STATE_DIR / "autopilot.json"
MODEL = "claude-haiku-4-5-20251001"
DENY = ["Bash(sudo:*)", "Bash(git push:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(ssh:*)",
        "Bash(scp:*)", "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)", "Bash(rm -rf /home:*)",
        "Bash(rm -rf $HOME:*)", "ScheduleWakeup", "CronCreate", "RemoteTrigger", "WebFetch", "WebSearch"]
MAX_CORRECTIONS = 3
MAX_EVOLVE_CALLS = 14
# One user message must not be able to run for an hour or to spend a session's
# whole budget in one turn. Both caps are recorded on the turn they stop, so a
# run that hit them can be told from one that did not.
MAX_TURNS = 40
TURN_TIMEOUT_MIN = 15
NO_EVOLVE = False

# Jev state for this run, decided once in main() and recorded in the manifest.
JEV = {"enabled": False, "model": None, "base_url": None}


def jev_env(base=None):
    """The environment every Claude turn and every `cortex` call inherits.

    With --jev off this switches Jev off explicitly rather than leaving it to
    whatever the machine's $CORTEX_HOME/.env happens to say: a run's treatment
    must not depend on the developer's dotfiles.
    """
    env = dict(base or os.environ, DISABLE_AUTOUPDATER="1")
    env["JEV_ENABLED"] = "1" if JEV["enabled"] else "0"
    if JEV["enabled"]:
        if JEV["model"]:
            env["JEV_MODEL"] = JEV["model"]
        if JEV["base_url"]:
            env["JEV_BASE_URL"] = JEV["base_url"]
    else:
        # an empty value SHADOWS a key set lower down; absent would not
        env["JEV_API_KEY"] = ""
    return env


ALIASES = ("jev-latest", "jev-preview")


def resolve_flags(argv):
    """--no-evolve, --max-turns and --turn-timeout, taken out of argv."""
    global NO_EVOLVE, MAX_TURNS, TURN_TIMEOUT_MIN
    if "--no-evolve" in argv:
        argv.remove("--no-evolve")
        NO_EVOLVE = True
    for flag, setter in (("--max-turns", "MAX_TURNS"), ("--turn-timeout", "TURN_TIMEOUT_MIN")):
        if flag in argv:
            i = argv.index(flag)
            if i + 1 >= len(argv) or not argv[i + 1].isdigit() or int(argv[i + 1]) < 1:
                raise SystemExit(f"autopilot: {flag} takes a positive whole number")
            globals()[setter] = int(argv[i + 1])
            del argv[i:i + 2]


def resolve_jev(argv):
    """Read --jev from argv, settle the model, and refuse an unreproducible run."""
    want = "off"
    if "--jev" in argv:
        i = argv.index("--jev")
        if i + 1 >= len(argv) or argv[i + 1] not in ("on", "off"):
            raise SystemExit("autopilot: --jev takes `on` or `off`")
        want = argv[i + 1]
        del argv[i:i + 2]
    JEV["enabled"] = want == "on"
    if not JEV["enabled"]:
        return
    model = os.environ.get("JEV_MODEL", "")
    JEV["base_url"] = os.environ.get("JEV_BASE_URL")
    if not model or model in ALIASES:
        raise SystemExit(
            f"autopilot: --jev on needs JEV_MODEL pinned to an exact version, not "
            f"{model or '(unset)'!r}.\n"
            "  An alias moves when TypeSafe ships a release, so the judge that\n"
            "  proposed this run's candidates would not be the one a reader replays\n"
            "  it with. Pin it: JEV_MODEL=jev-1.13.0 (see `cortex jev doctor` for\n"
            "  the id the endpoint is answering with).")
    JEV["model"] = model


def write_manifest():
    """One record per run of what the judge was, beside the model under test."""
    man = {"what": "manifest", "t": datetime.now().isoformat(timespec="seconds"),
           "rollout_model": MODEL, "jev": dict(JEV), "no_evolve": NO_EVOLVE,
           "turn_cap": MAX_TURNS, "turn_timeout_min": TURN_TIMEOUT_MIN,
           "repo": str(REPO), "state": str(L.STATE),
           "cortex": shutil.which("cortex"),
           "cortex_version": subprocess.run(["cortex", "version"], capture_output=True,
                                            text=True).stdout.strip() or None,
           "cli_version": subprocess.run(["claude", "--version"], capture_output=True,
                                         text=True).stdout.strip() or None}
    record(man)
    log(f"manifest: rollout model {MODEL} | jev "
        + (f"ON ({JEV['model']})" if JEV["enabled"] else "OFF")
        + (" | CONTROL RUN: no /evolve" if NO_EVOLVE else "")
        + f" | cortex {man['cortex']}")


def log(msg):
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}  {msg}"
    print(line, flush=True)
    with open(LOG, "a") as fh:
        fh.write(line + "\n")


def record(entry):
    data = json.loads(TURNS.read_text()) if TURNS.exists() else []
    data.append(entry)
    TURNS.write_text(json.dumps(data, indent=1))


def turn(prompt, resume=None, what="", timeout=None):
    """One user message to Claude Code, headless. Returns the result JSON (or an error stub).

    Two caps bound a single message: --max-turns, which Claude Code enforces, and a
    wall-clock timeout, which this does. Both are recorded on the turn they stopped
    (`hit_turn_cap`, `rc` 124), because a capped turn is a different observation
    from one that finished, and the report has to be able to count them.
    """
    timeout = TURN_TIMEOUT_MIN * 60 if timeout is None else timeout
    cmd = ["claude", "--model", MODEL, "--permission-mode", "bypassPermissions",
           "--output-format", "json", "--max-turns", str(MAX_TURNS)]
    if resume:
        cmd += ["--resume", resume]
    cmd += ["--disallowedTools", *DENY, "-p", prompt]
    t0 = time.time()
    try:
        p = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True, timeout=timeout,
                           env=jev_env())
        out = json.loads(p.stdout) if p.stdout.strip().startswith("{") else {}
        rc = p.returncode
    except subprocess.TimeoutExpired:
        out, rc = {}, 124
    hit_cap = out.get("subtype") == "error_max_turns" or out.get("stop_reason") == "max_turns"
    res = {"what": what, "t": datetime.now().isoformat(timespec="seconds"), "rc": rc,
           "session": out.get("session_id") or resume, "cost": out.get("total_cost_usd"),
           "turns": out.get("num_turns"), "secs": round(time.time() - t0),
           "hit_turn_cap": bool(hit_cap), "turn_cap": MAX_TURNS, "timeout_min": TURN_TIMEOUT_MIN,
           "is_error": out.get("is_error", rc != 0), "result": (out.get("result") or "")[-1500:]}
    record(res)
    log(f"   turn {what}: {res['secs']}s ${res['cost']} rc={rc}"
        + (" ERROR" if res["is_error"] else "")
        + (f" FINDING hit the {MAX_TURNS}-turn cap" if hit_cap else "")
        + (f" FINDING timed out after {TURN_TIMEOUT_MIN} min" if rc == 124 else "")
        + f" | {res['result'][-160:].strip().replace(chr(10), ' ')}")
    return res


def lab(*args):
    p = subprocess.run([str(HERE / "lab"), *args], capture_output=True, text=True,
                       env=jev_env())
    return p.returncode, p.stdout + p.stderr


def last_verdict(sid):
    rec = L.load_state()["scenarios"].get(sid, {})
    return (rec.get("attempts") or [{}])[-1].get("verdict")


def session(sid):
    rec = L.load_state()["scenarios"].get(sid, {})
    if rec.get("status") in ("done", "skipped"):
        log(f"{sid}: already {rec['status']}")
        return
    s = S.by_id(sid)
    if rec.get("status") != "open":
        rc, out = lab("next")
        if rc != 0:
            log(f"{sid}: lab next refused: {out.strip()[-300:]}")
            if L.load_state()["scenarios"].get(sid, {}).get("status") == "skipped":
                return
            raise SystemExit(f"FINDING {sid}: cannot start the session")
    log(f"{sid} ({s['family']}) {s['title']}")
    t = turn(s["prompt"], what=f"{sid} prompt")
    sess = t["session"]
    for i in range(MAX_CORRECTIONS + 1):
        lab("verify")
        v = last_verdict(sid)
        log(f"   verify: {v}")
        if v == "ok" or i == MAX_CORRECTIONS:
            break
        t = turn(L.correction(v, s), resume=sess, what=f"{sid} correction {v}")
    if v != "ok":
        log(f"FINDING {sid}: still '{v}' after {MAX_CORRECTIONS} corrections")
    turn("/harvest", resume=sess, what=f"{sid} /harvest")
    rc, out = lab("done")
    if rc != 0 and "no task was harvested" in out:
        log(f"FINDING {sid}: /harvest produced no task; asking once more, as a user would")
        turn("/harvest", resume=sess, what=f"{sid} /harvest again")
        rc, out = lab("done")
        if rc != 0 and "no task was harvested" in out:
            rc, out = lab("done", "--no-task")
    if rc != 0 and "not complete" in out:
        rc, out = lab("done", "--force")
    log(f"   {out.strip().splitlines()[0] if out.strip() else rc}")
    for w in out.splitlines()[1:]:
        if "!!" in w:
            log(f"FINDING {sid}: {w.strip()}")


def sweep_running():
    lock = REPO / ".evolve" / "runs" / ".lock"
    if not lock.exists():
        return False
    p = subprocess.run(["flock", "-n", str(lock), "true"])
    return p.returncode != 0


def wait_sweep():
    waited = 0
    while sweep_running():
        if waited % 600 == 0:
            tail = (REPO / ".evolve/runs/sweep.log")
            last = tail.read_text().strip().splitlines()[-1:] if tail.exists() else []
            log(f"   sweep running… {last[0] if last else ''}")
        time.sleep(30)
        waited += 30
    return waited


def snapshot():
    st = REPO / ".evolve" / "state.json"
    cycles = json.loads(st.read_text()).get("cycles", 0) if st.exists() else 0
    journal = (REPO / ".evolve" / "journal.md").read_text()
    cands = sorted(p.name for p in (REPO / ".evolve" / "candidate").glob("*"))
    runs = sorted(p.name for p in (REPO / ".evolve" / "runs").glob("*.jsonl"))
    return {"cycles": cycles, "entries": journal.count("\n## "), "cands": cands, "runs": runs}


def evolve(r):
    if NO_EVOLVE:
        # The control run's whole point: the same sessions, the same corrections,
        # the same /harvest, and nothing learned. `lab commit` still runs, so the
        # round's code and harvested tasks are committed exactly as usual.
        log(f"round {r}: /evolve SKIPPED (control run)")
        rc, out = lab("commit")
        log(f"   {out.strip()}")
        return
    start = snapshot()
    log(f"round {r}: /evolve (cycles so far {start['cycles']}, candidates {start['cands']})")
    stale = 0
    for n in range(MAX_EVOLVE_CALLS):
        w = wait_sweep()
        if w:
            log(f"   sweep finished after ~{w // 60} min")
        before = snapshot()
        t = turn("/evolve", what=f"round {r} /evolve #{n + 1}")
        time.sleep(5)
        after = snapshot()
        if sweep_running():
            stale = 0
            log(f"   a sweep is running: {[x for x in after['runs'] if x not in before['runs']]}")
            continue
        # a cycle has ended when the journal has its entry (KEEP, KILL or "nothing
        # to learn") and no candidate is left. The counter alone is not enough:
        # replaying the previous cycle's ending once bumped it with no new cycle.
        if after["entries"] > start["entries"] and not after["cands"]:
            log(f"round {r}: cycle ended (cycles {after['cycles']}, journal entries {after['entries']})")
            break
        if after["cycles"] > before["cycles"] and after["entries"] == before["entries"]:
            log(f"FINDING round {r}: a cycle was recorded with no journal entry")
        text = t["result"].lower()
        if "valid task" in text and ("not enough" in text or "only" in text or "insufficient" in text):
            log(f"round {r}: /evolve stopped on too few valid tasks")
            break
        if "barren" in text or "nothing to learn" in text:
            ended = after["entries"] > start["entries"]
            log(f"round {r}: BARREN" + ("" if ended else " — FINDING: no `cortex cycle`/journal record"))
            break
        stale = stale + 1 if after == before else 0
        if stale >= 2:
            log(f"FINDING round {r}: /evolve made no progress twice: {t['result'][-300:]}")
            break
    rc, out = lab("commit")
    log(f"   {out.strip()}")


def session_id(sid):
    for t in json.loads(TURNS.read_text()):
        if t["what"] == f"{sid} prompt" and t.get("session"):
            return t["session"]
    raise SystemExit(f"no recorded chat for {sid}")


def reharvest(sid, note):
    """A user who saw /harvest fail on a Cortex bug upgrades Cortex, goes back to
    that session's chat and asks again, saying why."""
    log(f"REHARVEST {sid}: {note}")
    turn(f"/harvest {note}", resume=session_id(sid), what=f"{sid} /harvest (after a Cortex fix)")
    rc, out = lab("done", "--late", sid)
    log(f"   {out.strip().splitlines()[0] if out.strip() else rc}")
    for w in out.splitlines()[1:]:
        if "!!" in w:
            log(f"FINDING {sid}: {w.strip()}")
    return rc


def ask(sid, message):
    """What a user types into a session's own chat after reading a report: no lab
    bookkeeping, just the message and what came back."""
    log(f"ASK {sid}: {message}")
    t = turn(message, resume=session_id(sid), what=f"{sid} ask")
    return 0 if not t["is_error"] else 1


def prune(max_turns=12):
    """The /prune pass, driven as a user would: /prune in a fresh chat, approve the
    plan it proposes in that same chat, then /prune again until it is finished."""
    sid = None
    for n in range(max_turns):
        st = subprocess.run(["cortex", "prune", "status"], cwd=REPO, capture_output=True, text=True).stdout
        log(f"prune #{n + 1}: status {st.strip().splitlines()[0] if st.strip() else '(none)'}")
        if "DONE" in st or "CANCELLED" in st:
            break
        t = turn("/prune", what=f"prune #{n + 1}")
        sid = t["session"]
        text = (t["result"] or "").lower()
        if "approve" in text and ("waiting" in text or "approval" in text or "shall i" in text or "proceed" in text):
            log("prune: approving the plan, as the user would")
            turn("Yes — approve the plan and start measuring.", resume=sid, what=f"prune #{n + 1} approve")
        if sweep_running():
            w = wait_sweep()
            log(f"   sweep finished after ~{w // 60} min")
    rc, out = lab("commit")
    log(f"   {out.strip()}")
    return 0


def main():
    argv = sys.argv[1:]
    resolve_jev(argv)                     # before anything spends a token
    resolve_flags(argv)
    known = {"round", "evolve", "prune", "ask", "reharvest"}
    if not argv or argv[0] not in known:
        print(__doc__.strip())
        return 2
    # nothing above this line writes anything; everything below it does
    guard.protect(REPO, "run the autopilot against")
    guard.protect(STATE_DIR, "write autopilot state into")
    if NO_EVOLVE and argv[:1] == ["evolve"]:
        raise SystemExit("autopilot: --no-evolve and `evolve` contradict each other")
    if len(argv) >= 1 and argv[0] == "prune":
        write_manifest()
        return prune()
    if len(argv) >= 3 and argv[0] == "ask":
        return ask(argv[1], argv[2])
    if len(argv) >= 3 and argv[0] == "reharvest":
        write_manifest()
        return reharvest(argv[1], argv[2])
    if len(argv) < 2 or argv[0] not in ("round", "evolve"):
        print(__doc__.strip())
        return 2
    write_manifest()
    sys.argv = [sys.argv[0], *argv]
    r = int(argv[1])
    if argv[0] == "round":
        log(f"===== round {r}: {S.ROUNDS[r]}")
        for sid in S.ROUNDS[r]:
            session(sid)
    evolve(r)
    log(f"===== round {r} finished")
    return 0


if __name__ == "__main__":
    sys.exit(main())
