__pycache__/
*.pyc
lab/state/*.out
lab/state/autopilot.log
lab/bench/results.jsonl
lab/bench/tasks.json
.DS_Store

# jev/corpus/ IS committed on purpose: it is the snapshot J0 scored, and
# `cortex clean --runs` deletes the .evolve/runs/ it came from. This one is the
# scratch file corpus.py writes while exploring, and it is not evidence.
jev/firing_corpus.jsonl

# secrets. NEVER commit a .env: it holds JEV_API_KEY, and a key that reaches a
# commit reaches every clone and every rollout sandbox made from one.
.env

# the lab report's figures as vector PDF: a build output (analysis/figures.py writes them
# for the paper), not shipped
lab/reports/figures/*.pdf

# the paper is kept and built outside this repository; its numbers come from lab/reports/
paper/

# virtual environments (lab/reports/analysis/run.sh makes one), or a link to one
.venv
